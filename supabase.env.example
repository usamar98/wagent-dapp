# Copy this file to .env.supabase.local (ignored by Git).
# Replace placeholders with connection strings from the intended Supabase project's Connect dialog.
# Database URLs are server-only. No frontend Supabase API key is used by this app.

NODE_ENV=development
APP_URL=http://localhost:5173
PORT=4000
DEMO_MODE=false
PAYMENT_PROVIDER=stripe_test

# Vercel/serverless runtime: Supavisor transaction pooler, port 6543.
# Copy the actual host from Connect; do not guess the aws-N prefix.
# Percent-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full&sslrootcert=./supabase/prod-ca-2021.crt

# Preserve the EXISTING encryption key when migrating encrypted connection records.
CREDENTIAL_ENCRYPTION_KEY=replace_with_existing_64_character_encryption_key

# The bundled public CA above comes from Supabase Database Settings.
# Run commands from the project root so sslrootcert resolves correctly.

ADMIN_WALLET_ADDRESSES=
# Optional existing provider settings:
JUPITER_API_KEY=
SOLANA_SWAPS_ENABLED=false
SOLANA_CHAT_TRADING_ENABLED=true
SOLANA_ALERTS_ENABLED=true
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
STRIPE_ELIGIBILITY_CONFIRMED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_COUNTRY=
