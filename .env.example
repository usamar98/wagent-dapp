# npm run dev creates an encrypted-key file and embedded PostgreSQL automatically.
# These values are for Docker Compose / an installed PostgreSQL database.
NODE_ENV=development
DEMO_MODE=true
DATABASE_URL=postgresql://agentbazaar:agentbazaar_local@localhost:5432/agentbazaar
# Optional direct connection for migrations when DATABASE_URL uses a provider pooler.
DIRECT_URL=
APP_URL=http://localhost:5173
PORT=4000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=replace_with_64_random_hex_characters
PAYMENT_PROVIDER=simulator

# Optional, TEST MODE only. Confirm product, country and marketplace eligibility first.
STRIPE_ELIGIBILITY_CONFIRMED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_COUNTRY=

# Optional Coinbase partner OAuth credentials. Requests account-read access only.
# Callback: APP_URL + /api/brokers/coinbase/callback. Live orders are unavailable.
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=

# Each user saves their personal WhatsApp Agent Platform API key in Connections.
# No shared WhatsApp key is needed. Run npm run worker for automatic polling.
# Legacy Business API verification / opt-out webhooks only.
META_APP_SECRET=
META_VERIFY_TOKEN=

# Public wallet addresses permitted to administer the marketplace. No private keys.
ADMIN_WALLET_ADDRESSES=
