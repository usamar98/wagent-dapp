# Supabase PostgreSQL. Copy supabase.env.example to .env.supabase.local.
NODE_ENV=development
DEMO_MODE=false
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full&sslrootcert=./supabase/prod-ca-2021.crt
# Supabase setup: supabase.env.example and docs/SUPABASE.md.
# The backend uses pg and SQL migrations directly against Supabase.
APP_URL=http://localhost:5173
PORT=4000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=replace_with_64_random_hex_characters
PAYMENT_PROVIDER=stripe_test

# Optional, TEST MODE only. Confirm product, country and marketplace eligibility first.
STRIPE_ELIGIBILITY_CONFIRMED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_COUNTRY=


# Provider keys are SERVER ONLY. Never use a VITE_ prefix.
# DEX Screener uses its public API; no key is required.
JUPITER_API_KEY=
# Enable mainnet swaps after adding the Jupiter key. Chat trades also require user opt-in.
SOLANA_SWAPS_ENABLED=false
SOLANA_ALERTS_ENABLED=true
# Optional global kill switch for advance-permission WhatsApp trading.
SOLANA_CHAT_TRADING_ENABLED=true
# HTTPS mainnet RPC for simulation, balances, withdrawals, and confirmation.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Each user saves their personal WhatsApp Agent Platform API key in Connections.
# No shared WhatsApp key is needed. Production uses the Supabase cloud schedule;
# see docs/CLOUD-WORKER.md. npm run worker is the optional standalone local loop.
# Legacy Business API verification / opt-out webhooks only.
META_APP_SECRET=
META_VERIFY_TOKEN=

# Public wallet addresses permitted to administer the marketplace. No private keys.
ADMIN_WALLET_ADDRESSES=
